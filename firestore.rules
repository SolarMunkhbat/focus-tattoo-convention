rules_version = '2';

// Replace with the same address as NEXT_PUBLIC_ADMIN_EMAIL in .env.local.
// This is the only account allowed to write site content.
function isAdmin() {
  return request.auth != null && request.auth.token.email == 'admin@focustattoo.mn';
}

service cloud.firestore {
  match /databases/{database}/documents {

    match /artists/{artistId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /schedule/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sponsors/{sponsorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /faq/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /battles/{battleId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
