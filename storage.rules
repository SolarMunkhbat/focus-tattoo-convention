rules_version = '2';

// Replace with the same address as NEXT_PUBLIC_ADMIN_EMAIL in .env.local.
function isAdmin() {
  return request.auth != null && request.auth.token.email == 'admin@focustattoo.mn';
}

service firebase.storage {
  match /b/{bucket}/o {

    match /artists/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /gallery/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /sponsors/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 4 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
