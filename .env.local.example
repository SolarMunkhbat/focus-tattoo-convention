# Vercel Blob — Vercel Dashboard → your project → Storage → Create Database → Blob
# → Connect to project. Locally: `npx vercel env pull .env.local` after connecting,
# or copy the token from Storage → your Blob store → .env.local tab.
BLOB_READ_WRITE_TOKEN=

# Admin login for /admin (a single account, not Firebase — plain username/password
# checked server-side, session is a signed cookie).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-too

# Convention date used by the countdown timer.
NEXT_PUBLIC_EVENT_START=2026-09-19T12:00:00+08:00
